# FreeGent — API keys
#
# RECOMMENDED: put your keys in ~/.config/freegent/credentials (create that file).
# That location is outside every git repo on your machine, so "git add -A" can
# never accidentally commit it.  Same KEY=VALUE format as this file.
#
#   mkdir -p ~/.config/freegent && cp .env.example ~/.config/freegent/credentials
#
# This file (.env.example) is safe to commit — all values are empty.
# You can still use <project>/.env as an override (gitignored); it takes
# precedence over the credentials file so project-specific keys work as expected.
#
# Keys are injected at dev-server startup by vite.config.ts and are never stored
# on any server — they go directly from your browser to the LLM provider endpoints.

# ── Free-tier providers (recommended starting points) ──────────────────────────

# Google Gemini — 10 RPM / 500 RPD on the free tier
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter — free model tier (many models, generous limits)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# NVIDIA NIM — free API credits for many models
# https://build.nvidia.com
NVIDIA_API_KEY=

# ── Paid / limited-free providers ──────────────────────────────────────────────

MISTRAL_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=

# ── Specialty providers ─────────────────────────────────────────────────────────

# Hugging Face Inference API
HF_API_KEY=

# NousPortal (Hermes, Llama models)
NOUSPORTAL_API_KEY=

# OpenCode (Qwen models)
OPENCODE_API_KEY=

# TokenHarbor
TOKENHARBOR_API_KEY=

# Kilo (coding models)
KILO_API_KEY=

# Vercel AI
VERCEL_API_KEY=

# ── Search providers (optional — used by the web search tool) ──────────────────

# Tavily — recommended for AI-optimised search
# https://app.tavily.com
TAVILY_API_KEY=

# Brave Search
BRAVE_API_KEY=

# ── Source control (optional — used by the GitHub tool) ────────────────────────

GITHUB_TOKEN=

# ── Q&A sites (optional) ───────────────────────────────────────────────────────

STACKEXCHANGE_API_KEY=
