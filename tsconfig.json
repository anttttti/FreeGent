{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "sourceMap": false,
    "declaration": false,
    "declarationMap": false,
    "strict": false,
    "noImplicitAny": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["*.ts", "*.tsx", "exec-sandbox/**/*", "shiro/**/*"],
  "exclude": [
    "node_modules",
    "tests",
    "vite.config.ts",
    "dev-api.ts",
    "dotenv.ts",
    "vitest.config.ts",
    "fg-run.ts",
    "fg-tui.tsx",
    "tui-app.tsx",
    "tui-placeholder.ts",
    "headless-runner.ts",
    "finish-summary.ts",
    "native-exec.ts",
    "exec-session.ts",
    "workspace-scan.ts",
    "safe-log.ts",
    "tui-env.ts",
    "loop-watch.ts",
    "mouse-input.ts",
    "tui-checkpoint.ts",
    "request-ledger.ts",
    "bootstrap-jsdom.ts",
    "node-fs-adapter.ts",
    "node-sqlite-adapter.ts"
  ]
}
