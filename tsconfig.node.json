{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": false,
    "noImplicitAny": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": [
    "globals.d.ts",
    "dev-api.ts",
    "secret-env.ts",
    "fg-run.ts",
    "dotenv.ts",
    "headless-runner.ts",
    "native-exec.ts",
    "bootstrap-jsdom.ts",
    "node-fs-adapter.ts",
    "node-sqlite-adapter.ts"
  ]
}
