{
  "name": "freegent",
  "version": "0.3.0",
  "description": "Browser WebUI and headless CLI for running AI agents against free-tier LLMs and local models",
  "type": "module",
  "author": "Antti Puurula",
  "license": "MIT",
  "keywords": [
    "llm",
    "ai-agent",
    "browser",
    "openrouter",
    "gemini",
    "ollama",
    "vllm",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anttttti/FreeGent.git"
  },
  "bugs": {
    "url": "https://github.com/anttttti/FreeGent/issues"
  },
  "homepage": "https://anttttti.github.io/FreeGent/",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "dev:lan:http": "FG_HTTP=1 vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "probe:headless": "node --experimental-strip-types --loader ./js-to-ts-loader.mjs scripts/headless-probe.mjs",
    "tui": "NODE_NO_WARNINGS=1 npx tsx --env-file-if-exists=.env fg-tui.tsx"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "ink": "^7.1.0",
    "ink-text-input": "^6.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "esbuild": "^0.28.2",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  }
}
